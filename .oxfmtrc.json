{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 80,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "ignorePatterns": [
    "**/dist",
    "**/node_modules",
    "**/.svelte-kit",
    "**/.next",
    "**/*.tsbuildinfo",
    "**/*.md",
    "**/e2e/test-results",
    "**/e2e/playwright-report",
    "**/*.html",
    "**/*.svelte",
    "**/*.vue",
    "**/.playwright",
    "**/artifacts"
  ],
  "endOfLine": "lf",
  "sortPackageJson": false,
  "sortImports": false,
  "sortTailwindcss": false
}
