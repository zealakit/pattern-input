{
  "name": "@zealakit/pattern-input",
  "version": "1.0.0-beta.1",
  "private": true,
  "description": "Headless, framework-agnostic behavioral primitives for specialized input fields.",
  "keywords": [
    "number-input",
    "masked-input",
    "otp",
    "one-time-code",
    "headless",
    "accessibility",
    "a11y",
    "ui",
    "zealakit",
    "react",
    "vue",
    "svelte",
    "vanilla",
    "typescript"
  ],
  "author": "nqhed - Huy Ed. Nguyen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zealakit/pattern-input.git"
  },
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "build:core": "pnpm --filter @zealakit/pattern-input-core run build",
    "build:vanilla": "pnpm --filter @zealakit/pattern-input-vanilla run build",
    "build:react": "pnpm --filter @zealakit/pattern-input-react run build",
    "build:vue": "pnpm --filter @zealakit/pattern-input-vue run build",
    "build:svelte": "pnpm --filter @zealakit/pattern-input-svelte run build",
    "typecheck": "pnpm -r --filter './packages/*' run typecheck",
    "test": "pnpm --filter @zealakit/pattern-input-core run test && pnpm --filter @zealakit/pattern-input-vanilla run test && pnpm --filter @zealakit/pattern-input-react run test && pnpm --filter @zealakit/pattern-input-vue run test && pnpm --filter @zealakit/pattern-input-svelte run test",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "check": "pnpm build && pnpm typecheck && pnpm test && pnpm lint",
    "clean": "pnpm -r exec rm -rf dist .next && rm -rf artifacts",
    "dev:vanilla": "pnpm --filter @zealakit/pattern-input-vanilla-example run dev",
    "dev:react": "pnpm --filter @zealakit/pattern-input-react-example run dev",
    "dev:vue": "pnpm --filter @zealakit/pattern-input-vue-example run dev",
    "dev:svelte": "pnpm --filter @zealakit/pattern-input-svelte-example run dev",
    "dev:nextjs": "pnpm --filter @zealakit/pattern-input-nextjs-example run dev",
    "monitor": "node --strip-types monitor/server.ts",
    "e2e": "pnpm --filter @zealakit/pattern-input-e2e run test",
    "readme:check": "node scripts/check-readmes.mjs",
    "pack:packages": "node scripts/pack-packages.mjs",
    "release:check": "pnpm check && pnpm pack:packages && node scripts/check-packages.mjs && node scripts/check-size.mjs",
    "npm:publish:check": "node --strip-types scripts/npm-publish.ts check",
    "npm:publish:vanilla": "node --strip-types scripts/npm-publish.ts vanilla",
    "npm:publish:react": "node --strip-types scripts/npm-publish.ts react",
    "npm:publish:vue": "node --strip-types scripts/npm-publish.ts vue",
    "npm:publish:svelte": "node --strip-types scripts/npm-publish.ts svelte",
    "npm:publish:all": "node --strip-types scripts/npm-publish.ts all",
    "size": "node scripts/check-size.mjs",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "esbuild": "^0.28.2",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "typescript": "^6.0.3"
  }
}
