{
  "name": "@zealakit/pattern-input-vue",
  "version": "1.0.0-beta.1",
  "description": "Headless, framework-agnostic behavioral primitives for specialized input fields for Vue.",
  "keywords": [
    "number-input",
    "masked-input",
    "otp",
    "headless",
    "zealakit",
    "vue",
    "vue3",
    "composable",
    "a11y"
  ],
  "author": "nqhed - Huy Ed. Nguyen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zealakit/pattern-input.git",
    "directory": "packages/vue"
  },
  "homepage": "https://github.com/zealakit/pattern-input#readme",
  "bugs": {
    "url": "https://github.com/zealakit/pattern-input/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@zealakit/pattern-input-core": "workspace:^"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "@zealakit/ui-engine": "^1.0.0-beta.1"
  },
  "devDependencies": {
    "@vue/test-utils": "^2.6.0",
    "happy-dom": "^21.0.4",
    "vue": "^3.5.45",
    "@zealakit/ui-engine": "link:../../../ui-engine"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tests/tsconfig.json --noEmit",
    "test": "pnpm build && node --import ./tests/setup.ts --test tests/*.test.ts",
    "test:watch": "node --import ./tests/setup.ts --test --watch tests/*.test.ts",
    "clean": "rm -rf dist",
    "prepack": "pnpm run build"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  }
}
